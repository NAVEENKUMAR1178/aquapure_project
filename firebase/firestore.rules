rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return request.auth != null && me().role == 'Admin'; }

    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      // users can only self-register as Customer or Dealer, never Admin; dealers start unapproved
      allow create: if request.auth.uid == uid
        && request.resource.data.role in ['Customer', 'Dealer']
        && request.resource.data.approved == (request.resource.data.role == 'Customer');
      allow update: if isAdmin() || (request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.approved == resource.data.approved);
    }
    match /products/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /orders/{id} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && (me().role == 'Customer' || (me().role == 'Dealer' && me().approved == true));
      allow update: if isAdmin();
    }
    match /services/{id} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin();
    }
  }
}
